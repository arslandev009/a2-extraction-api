# Provider/model/keys live in the ROOT ai-studio/.env (see packages/llm-client). Only A2-specific knobs here.
LLM_PROVIDER=gemini
MAX_UPLOAD_MB=3
MAX_PAGES=5
# Set to require the X-Gateway-Secret header (used when behind the Cloudflare edge function). Empty = off (local).
GATEWAY_SECRET=
# Used only when a document prints no currency at all (e.g. some receipts). Empty = such documents go to review.
DEFAULT_CURRENCY=
